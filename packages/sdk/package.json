{
  "name": "obj-gateway-sdk",
  "version": "0.2.0",
  "description": "Frontend SDK for obj-gateway: presigned S3 uploads via Go gateway",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolaTyolo/storage-api.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/SolaTyolo/storage-api/issues"
  },
  "homepage": "https://github.com/SolaTyolo/storage-api/tree/main/packages/sdk#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
