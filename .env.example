# Gateway
LISTEN_ADDR=:8080
JWT_SECRET=dev-secret-xxx
DEFAULT_EXPIRE_SEC=900

# JSON array of bucket configs (S3-compatible)
# endpoint = gateway→storage; publicEndpoint = browser-facing host in presigned URLs
BUCKET_CONFIG=[{"name":"uploads","endpoint":"http://localhost:9000","publicEndpoint":"http://localhost:9000","accessKey":"rustfsadmin","secretKey":"rustfsadmin","cdnDomain":"http://localhost:8081/uploads","useSSL":false,"region":"us-east-1"}]

# Docker: TCR mirrors are often amd64-only; force amd64 on Apple Silicon
DOCKER_PLATFORM=linux/amd64

# Go module proxy (use goproxy.cn when proxy.golang.org times out)
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# Docker base images (compose passes these as build args / service images)
# Override with TCR mirrors when Docker Hub is slow, e.g.:
# GOLANG_IMAGE=ccr.ccs.tencentyun.com/solat/golang:1.25-alpine
GOLANG_IMAGE=golang:1.25-alpine
ALPINE_IMAGE=alpine:3.21
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:alpine
RUSTFS_IMAGE=rustfs/rustfs:latest
RC_IMAGE=rustfs/rc:latest
