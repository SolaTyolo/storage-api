# Gateway
LISTEN_ADDR=:8080
# Required. To run without auth locally, leave empty and set ALLOW_NO_JWT=true.
JWT_SECRET=dev-secret-xxx
# ALLOW_NO_JWT=false
# Optional: enforce JWT "iss" / "aud" claims when set.
# JWT_ISSUER=
# JWT_AUDIENCE=
# Presigned URL lifetime: default and upper bound for client-supplied expireSec (S3 max 604800).
DEFAULT_EXPIRE_SEC=900
MAX_EXPIRE_SEC=86400
# Comma-separated browser origins allowed to call the gateway ("*" for any).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Max JSON request body size for /api/v1 calls.
MAX_BODY_BYTES=1048576

# JSON array of bucket configs (S3-compatible)
# name = API "bucket" field AND real storage bucket id (must match).
# With COS virtual style, name becomes the subdomain host, NOT a path prefix:
#   https://{name}.cos.ap-shanghai.myqcloud.com/{key}
# endpoint must be the regional host (cos.ap-shanghai.myqcloud.com), never <bucket>.cos.…
# Optional: "addressing":"virtual"|"path"|"auto", "maxUploadBytes", "allowedContentTypes"
BUCKET_CONFIG=[{"name":"uploads","endpoint":"http://localhost:9000","publicEndpoint":"http://localhost:9000","accessKey":"rustfsadmin","secretKey":"rustfsadmin","cdnDomain":"http://localhost:8081/uploads","useSSL":false,"region":"us-east-1"}]
# Docker: TCR mirrors are often amd64-only; force amd64 on Apple Silicon
DOCKER_PLATFORM=linux/amd64

# Go module proxy (use goproxy.cn when proxy.golang.org times out)
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# Docker base images (compose passes these as build args / service images)
# Override with TCR mirrors when Docker Hub is slow, e.g.:
# GOLANG_IMAGE=ccr.ccs.tencentyun.com/solat/golang:1.25-alpine
GOLANG_IMAGE=golang:1.25-alpine
ALPINE_IMAGE=alpine:3.21
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:alpine
# Pin storage images for reproducible dev stacks (rc has no versioned tag pinned yet).
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.3
RC_IMAGE=rustfs/rc:latest
